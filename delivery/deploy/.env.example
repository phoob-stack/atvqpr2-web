# Copy to deploy/.env and fill in. .env is git-ignored: never commit it.
# Placeholders only; no real values belong in this file.

# The public hostname (an A/AAAA record pointing at the VPS for the caddy
# profile; a public hostname on the tunnel for the tunnel profile).
DOMAIN=game.example.com

# Let's Encrypt account e-mail (caddy profile).
ACME_EMAIL=admin@example.com

# Cloudflare Tunnel token (tunnel profile only). Create the tunnel in the
# Cloudflare dashboard (Zero Trust > Networks > Tunnels), add a public
# hostname DOMAIN -> http://caddy-tunnel:80, and paste its token here.
TUNNEL_TOKEN=

# Where the pipeline output is, relative to deploy/ (node pipeline/build.mjs --hub-url /hub/).
OUT_DIR=../out

# Asset backend
ASSET_RATE_RPS=50
ASSET_RATE_BURST=200
# 1 behind Caddy alone; 2 with the tunnel (client, cloudflared).
ASSET_TRUST_PROXY_HOPS=1
# Serve objects from a CDN/bucket instead (upload out/assets/objects/ there):
# ASSET_CDN_BASE=https://cdn.example.com/boxquad/
# ASSET_CDN_MODE=redirect
# A CDN on another origin must send Cross-Origin-Resource-Policy: cross-origin
# (the launcher page is cross-origin isolated); set it here for proxy mode:
# ASSET_CORP=cross-origin

# Hub
HUB_MAX_PLAYERS=64
